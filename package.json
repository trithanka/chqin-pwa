{
  "name": "chqin",
  "private": "true",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @chqin/web",
    "dev:dashboard": "npm run dev --workspace @chqin/dashboard",
    "dev:api": "npm run dev --workspace @chqin/api",
    "dev:all": "concurrently -n web,dash,api -c blue,magenta,green \"npm:dev\" \"npm:dev:dashboard\" \"npm:dev:api\"",
    "build": "npm run build --workspace @chqin/web && npm run build --workspace @chqin/dashboard",
    "preview": "npm run preview --workspace @chqin/web",
    "lint": "oxlint",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run db:migrate --workspace @chqin/api",
    "db:psql": "docker exec -it chqin-postgres psql -U chqin -d chqin",
    "db:generate": "npm run db:generate --workspace @chqin/api",
    "db:push": "npm run db:push --workspace @chqin/api",
    "db:studio": "npm run db:studio --workspace @chqin/api",
    "db:seed": "npm run db:seed --workspace @chqin/api",
    "db:reset": "npm run db:reset --workspace @chqin/api",
    "db:clear": "npm run db:clear --workspace @chqin/api",
    "db:reseed": "npm run db:reseed --workspace @chqin/api",
    "dev:stop": "lsof -ti:5173,5174,8787 -sTCP:LISTEN | xargs -r kill || true"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "oxlint": "^1.75.0"
  }
}
