# Copy to .env and fill in. Never commit the filled-in version.
# Parsed and validated at boot by src/config.js — a bad value stops the
# process there rather than surfacing as a failed ceremony in a lobby.

# Local Postgres from `npm run db:up`:
DATABASE_URL=postgres://chqin:chqin@localhost:5439/chqin

# Hosted (Supabase and friends): app traffic on the transaction pooler,
# migrations on the session pooler. Percent-encode any reserved characters in
# the password — a literal "@" makes the parser read the rest as the hostname.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

PORT=8787

# WebAuthn credentials bind to the RP ID, which is a hostname. Changing this
# invalidates every enrolled passkey, so pick the production domain once.
RP_ID=localhost
RP_NAME=ChqIn

# Exactly one origin in production. Several in dev because Vite moves ports.
ORIGINS=http://localhost:5173,http://localhost:5174

# Keys the lookup hashes for emails and phone numbers. Without a real secret
# here those digests are offline-attackable — the input space is guessable.
#
# In production this value is permanent: it is the key behind every *_hmac
# column, so a new one means no staff member can sign in and no returning guest
# is recognised, with nothing to repair the rows from.
HASH_PEPPER=dev-only-pepper-change-me

# Decrypts the stored email addresses that password reset sends to. Separate
# from the pepper on purpose — one finds a row, the other reads it.
# Generate:  node -e "console.log(crypto.randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0zMi1ieXRlcyE=

# Resend — the mail behind password reset and address verification.
# https://resend.com → API Keys. Leave it empty locally and the message is
# printed to the log instead of sent, which is usually what you want; the link
# in that log line works exactly like the emailed one.
#
# Sending from chqin.in needs that domain verified in Resend first. Until the
# DNS records are in, Resend accepts the call and delivers only to the account
# owner's own address — which looks exactly like a bug in lib/mail.js.
RESEND_API_KEY=
MAIL_FROM=ChqIn <no-reply@chqin.in>

# Where the links inside those emails point. The dashboard's own address.
DASHBOARD_URL=http://localhost:5174
# How long a reset or verification link stays usable.
MAIL_TOKEN_TTL_MS=3600000

# TrueID (truid.one) — the KUA behind the Aadhaar OKYC check.
# https://truid.one → developer portal. Without these, identity checks fall back
# to a simulation and config.js refuses to start with NODE_ENV=production.
#
# The key decides the environment: a TEST_ key and a live key use the same base
# URL, so there is no separate staging host. Callers are also IP-whitelisted per
# environment — a correct key from an unlisted address returns 403, not 401.
#
# Two headers their published docs omit are sent on every call: X-Request-Id
# (exactly 32 alphanumeric characters) and X-Timestamp (unix seconds). See
# src/lib/truid.js.
TRUID_KEY_ID=
TRUID_KEY_SECRET=
TRUID_BASE_URL=https://service-api.truid.one/api/v1

# Force the simulation even with the keys above filled in — for working
# offline, or when the provider is down. Any six-digit code then passes, no
# UIDAI call is made and nothing is billed. Production refuses to start with
# this on, because credentials present plus simulation forced looks configured
# while letting every guest through.
SIMULATE_AADHAAR=false
