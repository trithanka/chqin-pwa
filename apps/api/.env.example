# Copy to .env for local work. Defaults match `npm run db:up`.

DATABASE_URL=postgres://chqin:chqin@localhost:5439/chqin
PORT=8787

# WebAuthn credentials bind to the RP ID, which is a hostname. Changing this
# invalidates every enrolled passkey, so pick the production domain once.
RP_ID=localhost
RP_NAME=ChqIn

# Exactly one origin in production. Several in dev because Vite moves ports.
ORIGINS=http://localhost:5173,http://localhost:5175

# Keys the lookup hashes for emails and phone numbers. Without a real secret
# here those digests are offline-attackable — the input space is guessable.
HASH_PEPPER=dev-only-pepper-change-me
