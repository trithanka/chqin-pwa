  "dependencies": {
    "@chqin/shared": "*",
    "@hono/node-server": "^1.14.0",
    "@simplewebauthn/server": "^13.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "pg": "^8.13.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  },
  "engines": {
    "node": ">=22"
  }
