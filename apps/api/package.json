{
  "name": "@chqin/api",
  "private": "true",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/shared/db/migrate.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node src/modules/hotel/seed.js",
    "db:reset": "node src/shared/db/reset.js && node src/shared/db/migrate.js && node src/modules/hotel/seed.js",
    "db:clear": "node src/shared/db/clear.js",
    "venue:office": "node src/modules/visitors/createOffice.js",
    "kapso:templates": "node src/integrations/kapso/templates.js",
    "admin:create": "node src/modules/admin/createAdmin.js",
    "db:reseed": "node src/shared/db/clear.js && node src/modules/hotel/seed.js"
